# STRATUM Twin Chain runtime configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
AUTH_SECRET=replace-with-at-least-32-random-characters

# Sovereign STRATUM Chain
STRATUM_CHAIN_ID=stratum-devnet-1
STRATUM_CHAIN_RPC_URL=https://YOUR-STRATUM-CHAIN-RPC
STRATUM_CHAIN_API_KEY=
STRATUM_CHAIN_SIGNER_ADDRESS=

# Optional public/default 3D reference model used by STRATUM Twin
NEXT_PUBLIC_STRATUM_TWIN_REFERENCE_MODEL_URL=
