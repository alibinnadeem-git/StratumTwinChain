# STRATUM Spatial Verified runtime configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
AUTH_SECRET=replace-with-at-least-32-random-characters

# One-time initial SUPER_ADMIN provisioning.
# Set all three only for bootstrap, issue the one-time setup token, then remove
# STRATUM_AUTH_BOOTSTRAP_SECRET after the first SUPER_ADMIN password is configured.
STRATUM_AUTH_BOOTSTRAP_SECRET=
STRATUM_AUTH_BOOTSTRAP_EMAIL=
STRATUM_AUTH_BOOTSTRAP_ORGANIZATION_ID=

# Sovereign STRATUM Chain
STRATUM_CHAIN_ID=stratum-devnet-1
STRATUM_CHAIN_RPC_URL=https://YOUR-STRATUM-CHAIN-RPC
STRATUM_CHAIN_API_KEY=
STRATUM_CHAIN_SIGNER_ADDRESS=

# Optional public/default 3D reference model used by STRATUM Spatial Verified
NEXT_PUBLIC_STRATUM_TWIN_REFERENCE_MODEL_URL=
